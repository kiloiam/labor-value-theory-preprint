    },
    {
      "@type": "DefinedTerm",
      "@id": "https://kiloiam.github.io/labor-value-theory-preprint/terms.html#4c4d1c2a39",
      "name": "历史唯物主义",
      "alternateName": "historical materialism",
      "description": "本文的分析立场：从生产方式的历史变迁理解经济范畴的成立条件与界限。",
      "inDefinedTermSet": {
        "@id": "https://kiloiam.github.io/labor-value-theory-preprint/terms.jsonld#set",
