    },
    {
      "@type": "DefinedTerm",
      "@id": "https://kiloiam.github.io/labor-value-theory-preprint/terms.html#de80eae015",
      "name": "马克思经济学",
      "alternateName": "Marxian economics",
      "description": "以马克思政治经济学批判为基础的经济学研究传统，劳动价值论是其中的核心议题之一。",
      "inDefinedTermSet": {
        "@id": "https://kiloiam.github.io/labor-value-theory-preprint/terms.jsonld#set",
        "name": "劳动价值论与价值范畴术语集"
